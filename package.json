{
  "name": "first-responder-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.server.json && concurrently -k \"tsc -p tsconfig.server.json --watch\" \"node --watch build-server/server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit",
    "start": "node build-server/server/index.js",
    "test": "tsc -p tsconfig.test.json && node --test --test-timeout=15000 build-tests/tests/*.test.js",
    "vexo:sim": "node scripts/vexo-bridge.mjs",
    "vexo:check": "node scripts/check-vexo-kit.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=24"
  }
}
