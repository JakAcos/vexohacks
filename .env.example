# Local simulated incident workspace. No real emergency services are connected.
PORT=3001
HOST=127.0.0.1
DATA_DIR=./data
AGENT_MODE=demo
# To opt in to Gemini extraction, set AGENT_MODE=gemini and both variables below.
# Select a currently available model from https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=

# Set only your own team number (1–999) once known. No default is guessed.
VEXO_BAND_NUMBER=
VEXO_KIT_PATH=./vexo-open-kit
COPILOT_URL=http://127.0.0.1:3001

# Optional server-side audio providers. Keep these in your own ignored .env.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
MINIMAX_API_KEY=
# Select a supported model and voice from your MiniMax account/docs.
MINIMAX_MODEL=
MINIMAX_VOICE_ID=

# Optional private remote deployment. Both values are required together.
# PUBLIC_ORIGIN=https://relay.example.com
# RELAY_ACCESS_TOKEN=generate-at-least-32-random-characters
