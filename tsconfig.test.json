  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "build-tests",
    "noEmit": false,
    "allowJs": true
  },
  "include": [
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
